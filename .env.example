# ==============================================================================
# FieldSmith Pro & PayPal Agentic Commerce — Environment Configuration
# ==============================================================================
# NOTE: This file contains sample configuration. Copy this file to .env and
# populate values. NEVER commit .env to public version control.

# ------------------------------------------------------------------------------
# Frontend Application (Vite / React)
# ------------------------------------------------------------------------------
# AG Studio v3.0.0 License Key (https://www.ag-grid.com/studio/react/licence-install/)
# Leave blank to run in developer evaluation mode (includes watermark)
VITE_AG_STUDIO_LICENSE_KEY=

# PayPal Developer Sandbox Client Credentials (https://developer.paypal.com/dashboard/)
# 'test' enables sandbox SDK buttons without live client verification
VITE_PAYPAL_CLIENT_ID=test
VITE_PAYPAL_PLAN_ID=P-5ML4271244454362WXNWU5NQ
VITE_PAYPAL_ENV=sandbox

# API Backend Gateway Target (used by Vite dev proxy if running Python backend)
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Python A2A Backend & Agent Network (FastAPI)
# ------------------------------------------------------------------------------
# Server host & port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Operating Mode: Set to 'true' to run fully offline without live external API keys
MOCK_EXTERNAL_APIS=true

# PayPal Developer REST Credentials (for server-side order/subscription verification)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Telecom Provisioning Credentials (Optional - simulated when MOCK_EXTERNAL_APIS=true)
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# Zapier Model Context Protocol / Natural Language Actions (Optional)
ZAPIER_NLA_API_KEY=

# Cryptographic Salt for Buyer Mandate HMAC-SHA256 Token Signing
A2A_MANDATE_SECRET=dev_a2a_mandate_signing_secret_do_not_use_in_prod
